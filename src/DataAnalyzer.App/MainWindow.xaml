<Window x:Class="DataAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DataAnalyzer · 시계열 데이터 분석" Width="1500" Height="900"
        Background="#F4F5F8" AllowDrop="True" FontFamily="Segoe UI, Malgun Gothic"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- 상단 도구 모음 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DDE1E8" BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel>
                <TextBlock x:Name="Readout" DockPanel.Dock="Right" VerticalAlignment="Center" FontFamily="Consolas" FontWeight="SemiBold" Margin="10,0,4,0" Text="Cursor: —"/>
                <WrapPanel VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Content="CSV 열기" Click="OpenCsv_Click"/>
                    <Button Content="기준 CSV 열기" ToolTip="열이 같은 기준(비교) CSV를 열어 1:1로 비교" Click="OpenRef_Click"/>
                    <Button Content="Clear" ToolTip="불러온 CSV와 차트를 모두 지웁니다" Click="Clear_Click"/>
                    <Button Content="샘플 데이터" Click="Sample_Click"/>
                    <TextBlock x:Name="FileNameText" VerticalAlignment="Center" Foreground="#6B7586" MaxWidth="220" TextTrimming="CharacterEllipsis" Margin="6,0"/>
                    <TextBlock Text="시간 열" VerticalAlignment="Center" Foreground="#6B7586" Margin="6,0,4,0"/>
                    <ComboBox x:Name="TimeCombo" Width="110" SelectionChanged="TimeCombo_SelectionChanged"/>
                    <StackPanel x:Name="CyclePanel" Orientation="Horizontal" Visibility="Collapsed" Margin="6,0,0,0">
                        <TextBlock Text="Cycle" VerticalAlignment="Center" Foreground="#6B7586" Margin="0,0,4,0"/>
                        <ComboBox x:Name="CycleCombo" Width="100" SelectionChanged="CycleFilter_Changed"/>
                        <TextBlock Text="Action" VerticalAlignment="Center" Foreground="#6B7586" Margin="6,0,4,0"/>
                        <ComboBox x:Name="ActionCombo" Width="110" SelectionChanged="CycleFilter_Changed"/>
                        <CheckBox x:Name="OverlayBox" Content="Cycle 기준 View" VerticalAlignment="Center" Margin="6,0,4,0" Click="CycleFilter_Changed"
                                  ToolTip="Cycle 단위로 분리해 각 Cycle(또는 선택한 Action 구간)의 시작을 0에 맞춰 겹쳐 표시"/>
                        <ComboBox x:Name="OverlayModeCombo" Width="90" SelectedIndex="0" ToolTip="겹침 표시 방식" SelectionChanged="OverlayMode_Changed">
                            <ComboBoxItem Tag="auto">자동</ComboBoxItem>
                            <ComboBoxItem Tag="ind">개별선</ComboBoxItem>
                            <ComboBoxItem Tag="band">평균±산포</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <Button Content="+ 차트 추가" Margin="8,2,2,2" Click="AddChart_Click"/>
                    <Button Content="Filter" ToolTip="Low-pass / 이동평균 (위상지연 없음)" Click="Filter_Click"/>
                    <Button Content="Cycle·Action 분석" ToolTip="조이스틱 신호로 Digging / Hauling / Dumping / Returning 자동 라벨링" Click="CycleAnalysis_Click"/>
                    <Button Content="전체 보기" Click="ResetView_Click"/>
                    <TextBlock Text="X" VerticalAlignment="Center" Foreground="#6B7586" Margin="6,0,4,0"/>
                    <TextBox x:Name="XMinBox" Width="130" KeyDown="XRange_KeyDown" LostFocus="XRange_LostFocus"/>
                    <TextBlock Text=" ~ " VerticalAlignment="Center"/>
                    <TextBox x:Name="XMaxBox" Width="130" KeyDown="XRange_KeyDown" LostFocus="XRange_LostFocus"/>
                    <ToggleButton x:Name="CursorBButton" Content="커서 B (델타/평균)" Margin="6,2,2,2" Padding="8,3" Click="CursorB_Click"/>
                    <Button Content="PNG 저장" Click="SavePng_Click"/>
                    <Button Content="구성·스타일 저장/불러오기" Click="Config_Click"/>
                    <CheckBox x:Name="KeepConfigBox" Content="새 데이터에 현재 구성 유지" VerticalAlignment="Center" Margin="6,0"/>
                    <!-- 기준 Data -->
                    <StackPanel x:Name="RefPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="8,0,0,0">
                        <CheckBox x:Name="RefShowBox" Content="기준 표시" IsChecked="True" VerticalAlignment="Center" Click="RefShow_Click"/>
                        <TextBlock Text="오프셋" VerticalAlignment="Center" Foreground="#6B7586" Margin="8,0,4,0"/>
                        <TextBox x:Name="RefOffsetBox" Width="70" KeyDown="RefOffset_KeyDown" LostFocus="RefOffset_LostFocus"/>
                        <TextBlock Text=" s" VerticalAlignment="Center" Foreground="#6B7586"/>
                        <Button Content="시작 맞춤" ToolTip="기준 Data 시작 시각을 현재 Data 시작 시각에 맞춤" Click="RefAlign_Click"/>
                        <Button Content="기준 해제" Click="RefClear_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="RefInfo" VerticalAlignment="Center" Foreground="#6B7586" Margin="8,0"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="120"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="150"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="150"/>
            </Grid.ColumnDefinitions>

            <!-- 신호 목록 -->
            <Border Grid.Column="0" Background="White" BorderBrush="#DDE1E8" BorderThickness="0,0,1,0" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="신호 목록 · 클릭 = 선택한 차트에 추가 / 차트로 드래그" FontSize="12" Foreground="#6B7586" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button x:Name="SortButton" DockPanel.Dock="Right" Content="A→Z" ToolTip="알파벳 순 ↔ CSV 원래 순서" Padding="6,1" Click="Sort_Click"/>
                        <TextBox x:Name="FilterBox" TextChanged="FilterBox_TextChanged" ToolTip="필터"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" FontSize="11" Foreground="#6B7586" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="차트 위: 클릭·드래그 = 커서 이동 · 휠 = 확대/축소 · Shift+드래그(또는 오른쪽 드래그) = 이동 · 가운데 드래그 = X·Y 이동 · Y축 위 휠 = Y 확대 · Y축 더블클릭 = Y 자동 · ←/→ = 샘플 단위 이동(Shift = 10) · 신호 칩 클릭 = 강조, 더블클릭 = 선 스타일, 끌기 = 다른 차트로 이동(Ctrl = 복사)"/>
                    <ListBox x:Name="SignalList" BorderThickness="0"
                             PreviewMouseLeftButtonDown="SignalList_MouseDown"
                             PreviewMouseMove="SignalList_MouseMove"
                             PreviewMouseLeftButtonUp="SignalList_MouseUp"/>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#DDE1E8" ResizeBehavior="PreviousAndNext"/>

            <!-- 시계열 차트 -->
            <ScrollViewer Grid.Column="2" x:Name="ChartScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <StackPanel x:Name="ChartPanel" Margin="10"/>
                    <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,120,0,0" TextAlignment="Center" Foreground="#6B7586"
                               Text="CSV 파일을 열거나 이 창에 끌어다 놓으세요.&#x0a;첫 열(또는 선택한 열)이 시간축이 됩니다."/>
                </Grid>
            </ScrollViewer>
            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="#DDE1E8" ResizeBehavior="PreviousAndNext"/>

            <!-- XY 차트 -->
            <DockPanel Grid.Column="4">
                <DockPanel DockPanel.Dock="Top" Margin="10,8,10,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="XY Chart 높이" VerticalAlignment="Center" Foreground="#6B7586" Margin="0,0,4,0"/>
                        <ComboBox x:Name="XYHeightCombo" Width="70" SelectedIndex="1" SelectionChanged="XYHeight_SelectionChanged">
                            <ComboBoxItem Tag="1.5">1.5배</ComboBoxItem>
                            <ComboBoxItem Tag="2">2배</ComboBoxItem>
                            <ComboBoxItem Tag="2.5">2.5배</ComboBoxItem>
                            <ComboBoxItem Tag="3">3배</ComboBoxItem>
                        </ComboBox>
                        <Button Content="+ XY 차트 추가" Margin="6,2,0,2" Click="AddXY_Click"/>
                    </StackPanel>
                    <TextBlock Text="XY 차트 (X축 = 신호)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer x:Name="XYScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="XYPanel" Margin="10"/>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
